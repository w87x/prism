# `make deps` installs everything PRISM can use (brew bundle).

# required to build
brew "go"
brew "node"

# optional: magnet / torrent / FTP downloads
brew "aria2"

# optional: JS-heavy pages and the interactive browser tools
cask "google-chrome"

# optional: a local database with vector search (or point PRISM at any PostgreSQL 14+ with pgvector)
brew "postgresql@16"
brew "pgvector"
